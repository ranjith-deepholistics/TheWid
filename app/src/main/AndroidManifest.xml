<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Wi-Fi status. Granted at install with no prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Each of these is asked for only after someone taps the feature that needs it. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".ShapesApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TheWid">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.TheWid"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.widgetconfig.WidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.TheWid.ConfigureSheet">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.BatteryWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_battery">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_battery" />
        </receiver>
        <receiver
            android:name=".widget.CellularWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_cellular">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cellular" />
        </receiver>
        <receiver
            android:name=".widget.WifiWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_wifi">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_wifi" />
        </receiver>
        <receiver
            android:name=".widget.SoundWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_sound">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sound" />
        </receiver>
        <receiver
            android:name=".widget.AlarmWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_alarm">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_alarm" />
        </receiver>
        <receiver
            android:name=".widget.TimeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_time">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_time" />
        </receiver>

        <receiver
            android:name=".widget.AlertsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_alerts">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_alerts" />
        </receiver>
        <receiver
            android:name=".widget.NowPlayingWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_now_playing">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_playing" />
        </receiver>

        <receiver
            android:name=".widget.WeekWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_week">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week" />
        </receiver>
        <receiver
            android:name=".widget.InnerCircleWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_inner_circle">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_inner_circle" />
        </receiver>
        <receiver
            android:name=".widget.DecideWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_decide">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_decide" />
        </receiver>
        <receiver
            android:name=".widget.MochiWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_mochi">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mochi" />
        </receiver>
        <receiver
            android:name=".widget.BreatheWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_breathe">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_breathe" />
        </receiver>

        <receiver
            android:name=".widget.FocusWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_focus">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_focus" />
        </receiver>

        <receiver
            android:name=".widget.MinuteTickReceiver"
            android:exported="false" />

        <!-- Counts notifications, matches message sender names in memory and reads media sessions.
             Never reads a notification's text. -->
        <service
            android:name=".data.status.platform.ShapesNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.StatusChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.WidgetPinnedReceiver"
            android:exported="false" />

        <!-- ShapesApplication configures WorkManager so workers can use Hilt. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>